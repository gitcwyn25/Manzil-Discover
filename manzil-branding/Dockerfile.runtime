# Compile from the public source before packaging; retain pinned native/runtime dependencies.
FROM mauriceboe/trek:5.1.0@sha256:23bf3fa6a134dc38a3b4f40ef8f7e8040abc96965105dffdcfcf5f202fb5d0b7
RUN rm -rf /app/server/dist /app/shared/dist
COPY --chown=node:node server-build/ /app/server/dist/
COPY --chown=node:node shared-build/ /app/shared/dist/
COPY --chown=node:node client-build/ /app/server/public/
COPY LICENSE NOTICE.md /app/
COPY release.json /app/manzil-release.json
COPY brand-help.mjs /tmp/manzil-brand-help.mjs
RUN node /tmp/manzil-brand-help.mjs /app/wiki \
    && rm /tmp/manzil-brand-help.mjs \
    && mv /app/data /app/image-data \
    && mv /app/uploads /app/image-uploads \
    && ln -s /persist/data /app/data \
    && ln -s /persist/uploads /app/uploads
COPY --chmod=0755 start.sh /usr/local/bin/manzil-discover-start
CMD ["/usr/local/bin/manzil-discover-start"]
LABEL org.opencontainers.image.title="Manzil Discover" \
      org.opencontainers.image.source="https://github.com/gitcwyn25/Manzil-Discover" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
